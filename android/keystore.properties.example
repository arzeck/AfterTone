# Copy to keystore.properties and fill in. That file is gitignored.
#
# Create the keystore once:
#   keytool -genkey -v -keystore aftertone-release.jks \
#       -keyalg RSA -keysize 2048 -validity 10000 -alias aftertone
#
storeFile=aftertone-release.jks
storePassword=
keyAlias=aftertone
keyPassword=
